{
  "name": "deepseek-harness-quota-monitor",
  "version": "0.3.0",
  "type": "module",
  "description": "Multi-provider quota monitor for DeepSeek Harness: balance type (query + JS parser) and window type (local sliding-window metering), with first-class Command Code support. Sidebar widget + Plugins page.",
  "repository": {
    "type": "git",
    "url": "https://github.com/marisa-4219/deepseek-harness-quota-monitor.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "quota",
    "monitor",
    "usage",
    "plugin"
  ],
  "author": "marisa-4219",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "category": "extension",
    "displayName": "额度监控",
    "image": "https://raw.githubusercontent.com/marisa-4219/deepseek-harness-quota-monitor/master/assets/cover.svg"
  },
  "license": "MIT"
}
